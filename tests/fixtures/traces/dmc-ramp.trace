# 15 (54 CPU cycles per bit) makes one loop 33*8*54 = 14256 cycles = 125.5 Hz.
# the sample bytes come from the meta sidecar's "dpcm" block, not from the trace.
0        4011 00
0        4010 4F
0        4012 00
0        4013 02
